# Generated production binaries (built in CI artifacts)
production/method_a_python/*.pdf
production/method_a_python/*.docx
production/method_b_hybrid/*.pdf
production/method_b_hybrid/*.docx
production/assembled/*.html
production/assembled/*.tex

# Python cache files
__pycache__/
*.py[cod]

# Editable Typst generated outputs
typst_content/output/*
!typst_content/output/.gitkeep
production/method_b_typst/output/*
!production/method_b_typst/output/.gitkeep
production/method_b_typst/generated/*
!production/method_b_typst/generated/.gitkeep
